{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-business-saas",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/webhook/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: Wrangler creates the D1 database on the first deploy (and reuses it afterwards),
      // whether deployed with the button, from the dashboard's Git connection, or by `wrangler deploy`.
      "database_name": "wa-business-saas-db"
    }
  ],
  "vars": {
    "ALLOW_SIGNUP": "false",
    "GRAPH_API_VERSION": "v21.0"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}

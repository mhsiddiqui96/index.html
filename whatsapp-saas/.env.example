# সার্ভার পোর্ট
PORT=3000

# টোকেন এনক্রিপশনের জন্য গোপন কী (লম্বা র‍্যান্ডম স্ট্রিং দিন)। না দিলে data/secret.key ফাইলে অটো তৈরি হবে।
SECRET_KEY=

# Meta App Dashboard → WhatsApp → Configuration → Webhook এ এই টোকেনটাই দিবেন
WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# Meta App Dashboard → App settings → Basic → App secret (webhook সিগনেচার যাচাইয়ের জন্য, প্রোডাকশনে অবশ্যই দিন)
META_APP_SECRET=

# Graph API ভার্সন
GRAPH_API_VERSION=v21.0

# নতুন বিজনেস নিজে সাইন-আপ করতে পারবে কিনা (SaaS মোড)। false দিলে শুধু প্রথম অ্যাকাউন্ট তৈরি করা যাবে।
ALLOW_SIGNUP=true

# HTTPS এর পিছনে চালালে true দিন (কুকি secure হবে)
COOKIE_SECURE=false

# VPS + docker compose এ চালালে: আপনার ডোমেইন/সাবডোমেইন (DNS A রেকর্ড সার্ভারের IP তে থাকতে হবে)
DOMAIN=
